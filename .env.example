# NEXUS Backend Configuration
PORT=8001
NODE_ENV=development
JWT_SECRET=nexus-development-jwt-secret-key-must-be-at-least-32-chars-long
DATABASE_URL="postgresql://nexus:nexuspassword@localhost:5433/nexus_db?schema=public"
REDIS_URL="redis://localhost:6379"

# AI Provider Configuration (auto, ollama, or openai)
AI_PROVIDER=auto
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Frontend Configuration
NEXUS_API_URL=http://localhost:8001
NEXUS_WS_URL=ws://localhost:8001
