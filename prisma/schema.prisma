generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  name              String
  passwordHash      String
  avatar            String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  sessions          Session[]
  workspaces        Workspace[]
  conversations     Conversation[]
  agentTasks        AgentTask[]
  researchProjects  ResearchProject[]
  memories          Memory[]
  skills            Skill[]
  approvals         ApprovalRequest[]
  approvalPolicies  ApprovalPolicy[]
  approvalDecisions ApprovalDecision[]
  activityEvents    ActivityEvent[]
  notifications     Notification[]
  aiProviderConfigs AIProviderConfig[]
  preferences       UserPreference[]
  codingProjects    CodingProject[]
  codeExecutions    CodeExecution[]
  webCaptures       WebCapture[]
  captureAnalyses   CaptureAnalysis[]
  downloads         DownloadRecord[]
  bookmarks         Bookmark[]
  historyItems      BrowserHistoryItem[]
  integrationConnections IntegrationConnection[]
  workflows         Workflow[]
  skillExecutions   SkillExecution[]

  @@index([email])
  @@index([createdAt])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model Workspace {
  id               String            @id @default(uuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  settings         Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  browserSessions  BrowserSession[]
  conversations    Conversation[]
  agentTasks       AgentTask[]
  researchProjects ResearchProject[]
  workflows        Workflow[]
  memories         Memory[]
  skills           Skill[]
  approvals        ApprovalRequest[]
  approvalPolicies ApprovalPolicy[]
  activityEvents   ActivityEvent[]
  codingProjects   CodingProject[]
  webCaptures      WebCapture[]
  downloads        DownloadRecord[]
  bookmarks        Bookmark[]
  historyItems     BrowserHistoryItem[]

  @@index([userId])
  @@index([createdAt])
}

model BrowserSession {
  id          String       @id @default(uuid())
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tabs        BrowserTab[]

  @@index([workspaceId])
  @@index([createdAt])
}

model BrowserTab {
  id               String         @id @default(uuid())
  browserSessionId String
  browserSession   BrowserSession @relation(fields: [browserSessionId], references: [id], onDelete: Cascade)
  url              String
  title            String
  favicon          String?
  position         Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([browserSessionId])
  @@index([position])
}

model Conversation {
  id               String            @id @default(uuid())
  workspaceId      String
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  spaceId          String?
  contextType      String?           @default("page")
  browserSessionId String?
  browserTabId     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  messages         Message[]
  snapshots        ContextSnapshot[]

  @@index([workspaceId])
  @@index([userId])
  @@index([spaceId])
  @@index([createdAt])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String       @db.Text
  model          String?
  status         String       @default("completed")
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([status])
  @@index([createdAt])
}

model ContextSnapshot {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  url            String?
  title          String?
  selectedText   String?      @db.Text
  sourceType     String       @default("page")
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

model AgentTask {
  id          String            @id @default(uuid())
  workspaceId String
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  spaceId     String?
  title       String
  goal        String            @db.Text
  status      String            @default("pending")
  priority    String            @default("medium")
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  runs        AgentRun[]
  steps       AgentStep[]
  approvals   ApprovalRequest[]
  activities  ActivityEvent[]

  @@index([workspaceId])
  @@index([userId])
  @@index([spaceId])
  @@index([status])
  @@index([createdAt])
}

model AgentRun {
  id            String             @id @default(uuid())
  agentTaskId   String
  task          AgentTask          @relation(fields: [agentTaskId], references: [id], onDelete: Cascade)
  status        String             @default("RUNNING") // DRAFT, READY, RUNNING, PAUSED, WAITING_APPROVAL, COMPLETED, FAILED, CANCELLED
  model         String?
  executionMode String             @default("balanced") // quick, balanced, advanced
  startedAt     DateTime           @default(now())
  completedAt   DateTime?
  currentStep   Int                @default(0)
  progress      Float              @default(0)
  error         String?            @db.Text
  metadata      Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @default(now()) @updatedAt

  plans         AgentPlan[]
  steps         AgentStep[]
  toolCalls     AgentToolCall[]
  observations  AgentObservation[]
  artifacts     AgentArtifact[]
  approvals     ApprovalRequest[]

  @@index([agentTaskId])
  @@index([status])
  @@index([createdAt])
}

model AgentPlan {
  id          String    @id @default(uuid())
  agentRunId  String
  run         AgentRun  @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  version     Int       @default(1)
  status      String    @default("active") // active, revised, completed
  steps       Json      // array of PlannedStep objects
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([agentRunId])
}

model AgentStep {
  id          String             @id @default(uuid())
  taskId      String?
  task        AgentTask?         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agentRunId  String?
  run         AgentRun?          @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  stepIndex   Int                @default(0)
  type        String             @default("tool_call") // tool_call, verification, answer, plan
  description String?            @db.Text
  toolName    String?
  status      String             @default("pending") // PENDING, RUNNING, WAITING_APPROVAL, COMPLETED, FAILED, SKIPPED, CANCELLED
  retryCount  Int                @default(0)
  input       Json?
  output      Json?
  error       String?            @db.Text
  metadata    Json?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @default(now()) @updatedAt

  toolCalls    AgentToolCall[]
  observations AgentObservation[]

  @@index([taskId])
  @@index([agentRunId])
  @@index([status])
  @@index([createdAt])
}

model AgentToolCall {
  id          String     @id @default(uuid())
  agentRunId  String
  run         AgentRun   @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  agentStepId String?
  step        AgentStep? @relation(fields: [agentStepId], references: [id], onDelete: SetNull)
  toolName    String
  input       Json?
  output      Json?
  status      String     @default("completed") // pending, running, completed, failed
  durationMs  Int?
  error       String?    @db.Text
  createdAt   DateTime   @default(now())

  @@index([agentRunId])
  @@index([agentStepId])
  @@index([toolName])
}

model AgentObservation {
  id            String     @id @default(uuid())
  agentRunId    String
  run           AgentRun   @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  agentStepId   String?
  step          AgentStep? @relation(fields: [agentStepId], references: [id], onDelete: SetNull)
  url           String?
  title         String?
  summary       String?    @db.Text
  extractedData Json?
  metadata      Json?
  createdAt     DateTime   @default(now())

  @@index([agentRunId])
  @@index([agentStepId])
}

model AgentArtifact {
  id          String   @id @default(uuid())
  agentRunId  String
  run         AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  type        String   // report, document, research, url, file, memory, task, workflow
  name        String
  location    String?
  content     String?  @db.Text
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([agentRunId])
  @@index([type])
}

// ============================================================
// NEXUS MEMORY — Full Production Schema
// ============================================================

model Memory {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId     String?
  workspace       Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Classification
  type            String    @default("FACT")   // MemoryType enum values
  category        String?
  title           String    @default("")
  key             String    @default("")        // Legacy compat

  // Content
  summary         String?   @db.Text
  content         String    @db.Text
  metadata        Json?

  // Scoring
  importanceScore Float     @default(0.5)
  confidenceScore Float     @default(0.8)
  importance      Float     @default(1.0)      // Legacy compat

  // Status
  status          String    @default("ACTIVE") // CANDIDATE | ACTIVE | PINNED | ARCHIVED | DELETED
  isPinned        Boolean   @default(false)
  isUserVerified  Boolean   @default(false)

  // Provenance
  sourceCount     Int       @default(0)
  accessCount     Int       @default(0)

  // Embedding lifecycle
  embeddingStatus String    @default("PENDING") // PENDING | PROCESSING | READY | FAILED

  // Soft delete
  archivedAt      DateTime?
  deletedAt       DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastAccessedAt  DateTime?

  // Relations
  chunks          MemoryChunk[]
  embeddings      MemoryEmbedding[]
  sources         MemorySource[]
  outgoingRelations MemoryRelation[] @relation("MemoryRelationSource")
  incomingRelations MemoryRelation[] @relation("MemoryRelationTarget")
  collectionItems MemoryCollectionItem[]
  tagRelations    MemoryTagRelation[]
  events          MemoryEvent[]
  notes           MemoryNote[]
  suggestions     MemorySuggestion[]
  accessLog       MemoryAccess[]

  @@index([userId])
  @@index([workspaceId])
  @@index([key])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([importanceScore])
  @@index([userId, workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, updatedAt])
}

model MemoryChunk {
  id         String   @id @default(uuid())
  memoryId   String
  memory     Memory   @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  chunkIndex Int      @default(0)
  content    String   @db.Text
  tokenCount Int      @default(0)
  createdAt  DateTime @default(now())

  embeddings MemoryEmbedding[]

  @@index([memoryId])
  @@index([chunkIndex])
}

model MemoryEmbedding {
  id        String       @id @default(uuid())
  memoryId  String
  memory    Memory       @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  chunkId   String?
  chunk     MemoryChunk? @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  model     String       @default("nomic-embed-text")
  vector    Json         // Float[] stored as JSON (pgvector upgrade path)
  dims      Int          @default(768)
  createdAt DateTime     @default(now())

  @@index([memoryId])
  @@index([chunkId])
}

model MemorySource {
  id           String   @id @default(uuid())
  memoryId     String
  memory       Memory   @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  url          String?
  title        String
  domain       String?
  author       String?
  publishedAt  DateTime?
  retrievedAt  DateTime @default(now())
  sourceType   String   @default("WEB") // WEB | PAPER | DOCUMENT | VIDEO | CHAT | AGENT | USER_NOTE
  summary      String?  @db.Text
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([memoryId])
  @@index([sourceType])
  @@index([createdAt])
}

model MemoryRelation {
  id           String   @id @default(uuid())
  sourceId     String
  source       Memory   @relation("MemoryRelationSource", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId     String
  target       Memory   @relation("MemoryRelationTarget", fields: [targetId], references: [id], onDelete: Cascade)
  relationType String   @default("RELATED_TO") // RELATED_TO | MENTIONS | DERIVED_FROM | BELONGS_TO | SUPPORTS | CONTRADICTS | SAME_TOPIC | SAME_PROJECT | SAME_SOURCE | CREATED_FROM | UPDATED_FROM
  strength     Float    @default(0.5)
  confidence   Float    @default(0.8)
  isAutomatic  Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@unique([sourceId, targetId, relationType])
  @@index([sourceId])
  @@index([targetId])
  @@index([relationType])
}

model MemoryCollection {
  id          String   @id @default(uuid())
  userId      String
  workspaceId String?
  name        String
  description String?  @db.Text
  color       String?  @default("#6366f1")
  icon        String?  @default("folder")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       MemoryCollectionItem[]

  @@index([userId])
  @@index([workspaceId])
}

model MemoryCollectionItem {
  id           String           @id @default(uuid())
  collectionId String
  collection   MemoryCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  memoryId     String
  memory       Memory           @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  addedAt      DateTime         @default(now())

  @@unique([collectionId, memoryId])
  @@index([collectionId])
  @@index([memoryId])
}

model MemoryTag {
  id        String              @id @default(uuid())
  name      String              @unique
  color     String?
  createdAt DateTime            @default(now())

  relations MemoryTagRelation[]
}

model MemoryTagRelation {
  id       String    @id @default(uuid())
  memoryId String
  memory   Memory    @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  tagId    String
  tag      MemoryTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([memoryId, tagId])
  @@index([memoryId])
  @@index([tagId])
}

model MemoryEvent {
  id        String   @id @default(uuid())
  memoryId  String?
  memory    Memory?  @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  userId    String
  workspaceId String?
  eventType String   // MEMORY_CREATED | MEMORY_UPDATED | MEMORY_VIEWED | MEMORY_VERIFIED | MEMORY_ARCHIVED | RESEARCH_SAVED | AGENT_RESULT_SAVED | SOURCE_ADDED | NOTE_ADDED | RELATION_CREATED
  title     String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([memoryId])
  @@index([userId])
  @@index([workspaceId])
  @@index([eventType])
  @@index([createdAt])
}

model MemoryNote {
  id        String   @id @default(uuid())
  memoryId  String
  memory    Memory   @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  isAI      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([memoryId])
}

model MemoryAccess {
  id        String   @id @default(uuid())
  memoryId  String
  memory    Memory   @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  userId    String
  source    String   @default("USER") // USER | ASSISTANT | RESEARCH | AGENT
  createdAt DateTime @default(now())

  @@index([memoryId])
  @@index([userId])
  @@index([createdAt])
}

model MemorySuggestion {
  id         String   @id @default(uuid())
  memoryId   String?
  memory     Memory?  @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  userId     String
  workspaceId String?
  type       String   // CONNECT | MERGE | REVIEW | VERIFY | UPDATE | MISSING_RELATION | CONTRADICTION | STALE
  title      String
  description String  @db.Text
  metadata   Json?
  isDismissed Boolean @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([workspaceId])
  @@index([memoryId])
  @@index([isDismissed])
}

model ResearchProject {
  id          String           @id @default(uuid())
  userId      String?
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspaceId String
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  spaceId     String?
  name        String
  title       String?
  question    String           @db.Text
  mode        String           @default("standard") // quick, standard, deep
  status      String           @default("in_progress") // in_progress, completed, paused, failed, cancelled
  finalReport String?          @db.Text
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  runs        ResearchRun[]
  plans       ResearchPlan[]
  sources     ResearchSource[]
  evidence    EvidenceItem[]
  findings    ResearchFinding[]
  reports     ResearchReport[]
  citations   ResearchCitation[]
  notes       ResearchNote[]

  @@index([workspaceId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model ResearchRun {
  id                String          @id @default(uuid())
  researchProjectId String
  project           ResearchProject @relation(fields: [researchProjectId], references: [id], onDelete: Cascade)
  status            String          @default("queued") // queued, planning, searching, extracting, analyzing, synthesizing, completed, paused, cancelled, failed
  progress          Float           @default(0)
  startedAt         DateTime        @default(now())
  completedAt       DateTime?
  error             String?         @db.Text
  metadata          Json?

  @@index([researchProjectId])
  @@index([status])
  @@index([startedAt])
}

model ResearchPlan {
  id                String          @id @default(uuid())
  researchProjectId String
  project           ResearchProject @relation(fields: [researchProjectId], references: [id], onDelete: Cascade)
  objectives        Json            // array of { id, title, status, order }
  status            String          @default("active")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([researchProjectId])
  @@index([createdAt])
}

model ResearchSource {
  id                String             @id @default(uuid())
  researchProjectId String
  project           ResearchProject    @relation(fields: [researchProjectId], references: [id], onDelete: Cascade)
  url               String
  title             String
  domain            String?
  sourceType        String             @default("web") // web, paper, docs, github, news
  status            String             @default("completed") // discovered, queued, fetching, extracting, analyzing, completed, failed
  content           String?            @db.Text
  summary           String?            @db.Text
  contentHash       String?
  retrievedAt       DateTime           @default(now())
  metadata          Json?
  createdAt         DateTime           @default(now())

  evidence          EvidenceItem[]
  citations         ResearchCitation[]

  @@index([researchProjectId])
  @@index([status])
  @@index([createdAt])
}

model EvidenceItem {
  id                String             @id @default(uuid())
  researchProjectId String
  project           ResearchProject    @relation(fields: [researchProjectId], references: [id], onDelete: Cascade)
  sourceId          String
  source            ResearchSource     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  claim             String             @db.Text
  evidenceText      String             @db.Text
  location          String?
  metadata          Json?
  createdAt         DateTime           @default(now())

  citations         ResearchCitation[]

  @@index([researchProjectId])
  @@index([sourceId])
  @@index([createdAt])
}

model ResearchFinding {
  id                String             @id @default(uuid())
  researchProjectId String
  project           ResearchProject    @relation(fields: [researchProjectId], references: [id], onDelete: Cascade)
  title             String
  summary           String             @db.Text
  claim             String             @db.Text
  confidence        Float              @default(0.85)
  status            String             @default("SUPPORTED") // SUPPORTED, PARTIALLY_SUPPORTED, CONFLICTING, UNSUPPORTED
  metadata          Json?
  createdAt         DateTime           @default(now())

  citations         ResearchCitation[]

  @@index([researchProjectId])
  @@index([status])
  @@index([createdAt])
}

model ResearchReport {
  id                String          @id @default(uuid())
  researchProjectId String
  project           ResearchProject @relation(fields: [researchProjectId], references: [id], onDelete: Cascade)
  title             String
  summary           String          @db.Text
  sections          Json            // array of { id, heading, content, citations }
  status            String          @default("final")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([researchProjectId])
  @@index([createdAt])
}

model ResearchCitation {
  id                String           @id @default(uuid())
  researchProjectId String
  project           ResearchProject  @relation(fields: [researchProjectId], references: [id], onDelete: Cascade)
  sourceId          String
  source            ResearchSource   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  evidenceId        String?
  evidence          EvidenceItem?    @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  findingId         String?
  finding           ResearchFinding? @relation(fields: [findingId], references: [id], onDelete: Cascade)
  inlineIndex       Int              @default(1)
  claim             String?          @db.Text
  metadata          Json?
  createdAt         DateTime         @default(now())

  @@index([researchProjectId])
  @@index([sourceId])
  @@index([evidenceId])
  @@index([findingId])
}

model ResearchNote {
  id                String          @id @default(uuid())
  researchProjectId String
  project           ResearchProject @relation(fields: [researchProjectId], references: [id], onDelete: Cascade)
  content           String          @db.Text
  metadata          Json?
  createdAt         DateTime        @default(now())

  @@index([researchProjectId])
  @@index([createdAt])
}


model Workflow {
  id          String              @id @default(uuid())
  workspaceId String
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  name        String
  description String?             @db.Text
  definition  Json
  status      String              @default("active") // active, draft, archived
  version     Int                 @default(1)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  versions    WorkflowVersion[]
  executions  WorkflowExecution[]

  @@index([workspaceId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model WorkflowVersion {
  id          String    @id @default(uuid())
  workflowId  String
  workflow    Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  version     Int
  definition  Json
  changeLog   String?   @db.Text
  createdAt   DateTime  @default(now())

  @@unique([workflowId, version])
  @@index([workflowId])
  @@index([version])
}

model WorkflowExecution {
  id          String                  @id @default(uuid())
  workflowId  String
  workflow    Workflow                @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  version     Int                     @default(1)
  status      String                  @default("running") // queued, running, waiting_for_approval, paused, completed, partially_completed, failed, cancelled
  mode        String                  @default("assisted") // manual, assisted, autonomous
  input       Json?
  output      Json?
  error       String?                 @db.Text
  startedAt   DateTime                @default(now())
  completedAt DateTime?

  steps       WorkflowStepExecution[]

  @@index([workflowId])
  @@index([status])
  @@index([startedAt])
}

model WorkflowStepExecution {
  id          String            @id @default(uuid())
  executionId String
  execution   WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  stepId      String
  nodeId      String?
  nodeType    String?
  status      String            @default("pending") // pending, ready, running, waiting_for_approval, succeeded, failed, skipped, cancelled
  input       Json?
  output      Json?
  error       String?           @db.Text
  retryCount  Int               @default(0)
  startedAt   DateTime?
  completedAt DateTime?

  @@index([executionId])
  @@index([status])
  @@index([stepId])
}

model Skill {
  id               String           @id @default(uuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId      String?
  workspace        Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name             String
  description      String           @db.Text
  instructions     String?          @db.Text
  category         String           @default("automation") // research, browser, coding, automation, data
  currentVersion   Int              @default(1)
  lifecycleState   String           @default("draft") // draft, validating, ready, active, disabled, deprecated, failed_validation
  tags             String[]         @default([])
  icon             String?
  isSystem         Boolean          @default(false)
  definition       Json?
  inputSchema      Json?
  outputSchema     Json?
  tools            Json?
  permissions      Json?
  config           Json?
  validationErrors Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  versions         SkillVersion[]
  executions       SkillExecution[]
  tests            SkillTest[]

  @@index([userId])
  @@index([workspaceId])
  @@index([lifecycleState])
  @@index([category])
  @@index([createdAt])
}

model SkillVersion {
  id           String           @id @default(uuid())
  skillId      String
  skill        Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)
  version      Int
  definition   Json
  inputSchema  Json
  outputSchema Json
  tools        Json
  permissions  Json
  config       Json?
  changeLog    String?          @db.Text
  createdAt    DateTime         @default(now())

  executions   SkillExecution[]
  tests        SkillTest[]

  @@unique([skillId, version])
  @@index([skillId])
  @@index([version])
}

model SkillExecution {
  id             String        @id @default(uuid())
  skillId        String
  skill          Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillVersionId String?
  skillVersion   SkillVersion? @relation(fields: [skillVersionId], references: [id], onDelete: SetNull)
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  caller         String?       @default("manual") // manual, agent, workflow:<id>
  status         String        @default("queued") // queued, running, waiting_for_approval, completed, partially_completed, failed, cancelled
  inputs         Json?
  outputs        Json?
  error          String?       @db.Text
  durationMs     Int           @default(0)
  artifacts      Json?
  toolExecutions Json?
  startedAt      DateTime      @default(now())
  completedAt    DateTime?

  @@index([skillId])
  @@index([skillVersionId])
  @@index([userId])
  @@index([status])
  @@index([startedAt])
}

model SkillTest {
  id              String        @id @default(uuid())
  skillId         String
  skill           Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillVersionId  String?
  skillVersion    SkillVersion? @relation(fields: [skillVersionId], references: [id], onDelete: SetNull)
  name            String
  description     String?
  inputs          Json
  expectedOutputs Json?
  status          String        @default("pending") // pending, passed, failed
  result          Json?
  error           String?       @db.Text
  durationMs      Int           @default(0)
  lastRunAt       DateTime?
  createdAt       DateTime      @default(now())

  @@index([skillId])
  @@index([skillVersionId])
  @@index([status])
}

model ApprovalRequest {
  id                  String             @id @default(uuid())
  userId              String
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId         String
  workspace           Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  taskId              String?
  task                AgentTask?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  agentRunId          String?
  agentRun            AgentRun?          @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  workflowExecutionId String?
  stepId              String?
  actionTitle         String?
  actionType          String?
  action              String
  target              String
  details             Json?
  requestingActor     String?
  callerId            String?
  payloadDigest       String?
  riskLevel           String?            @default("moderate")
  status              String             @default("pending") // pending, approved, rejected, expired, cancelled
  policyId            String?
  policy              ApprovalPolicy?    @relation(fields: [policyId], references: [id], onDelete: SetNull)
  skillExecutionId    String?
  createdAt           DateTime           @default(now())
  expiresAt           DateTime?
  resolvedAt          DateTime?
  decisions           ApprovalDecision[]

  @@index([userId])
  @@index([workspaceId])
  @@index([taskId])
  @@index([agentRunId])
  @@index([workflowExecutionId])
  @@index([skillExecutionId])
  @@index([policyId])
  @@index([status])
  @@index([createdAt])
}

model ApprovalPolicy {
  id               String            @id @default(uuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId      String?
  workspace        Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  name             String
  category         String            // external_communication, form_submission, destructive_operation, sensitive_data_access, browser_mutation
  description      String
  riskThreshold    String            @default("moderate") // low, moderate, high, critical
  requiresApproval Boolean           @default(true)
  autoExpireHours  Int               @default(24)
  enabled          Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  approvalRequests ApprovalRequest[]

  @@index([userId])
  @@index([workspaceId])
  @@index([category])
  @@index([enabled])
}

model ApprovalDecision {
  id                String          @id @default(uuid())
  approvalRequestId String
  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  decision          String          // approved, rejected, cancelled
  reason            String?
  payloadDigest     String?
  decidedAt         DateTime        @default(now())

  @@index([approvalRequestId])
  @@index([userId])
  @@index([decision])
  @@index([decidedAt])
}

model ActivityEvent {
  id                  String     @id @default(uuid())
  userId              String
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId         String?
  workspace           Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  taskId              String?
  task                AgentTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  agentRunId          String?
  category            String     @default("system") // browser, agents, approvals, system
  actorType           String     @default("system") // user, agent, workflow, system
  actorId             String?
  sourceModule        String     @default("system") // browser, coding, research, automation, workflows, skills, approvals, auth, settings, system
  actionName          String?
  outcome             String     @default("success") // success, failure, warning, pending
  correlationId       String?
  workflowExecutionId String?
  skillExecutionId    String?
  approvalRequestId   String?
  type                String
  message             String     @db.Text
  metadata            Json?
  createdAt           DateTime   @default(now())

  @@index([userId])
  @@index([workspaceId])
  @@index([taskId])
  @@index([agentRunId])
  @@index([category])
  @@index([actorType])
  @@index([sourceModule])
  @@index([outcome])
  @@index([correlationId])
  @@index([type])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

model AIProviderConfig {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        String
  model           String
  baseUrl         String?
  encryptedConfig String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([provider])
}

model UserPreference {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId])
}

// ============================================================
// NEXUS AI CODING AGENT & PROJECTS
// ============================================================

model CodingProject {
  id               String            @id @default(uuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId      String?
  workspace        Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name             String
  description      String?           @db.Text
  language         String            @default("python")
  problemTitle     String?
  problemStatement String?           @db.Text
  problemUrl       String?
  currentCode      String            @db.Text
  timeComplexity   String?
  spaceComplexity  String?
  explanation      String?           @db.Text
  testCases        Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  files            ProjectFile[]
  versions         CodeVersion[]
  executions       CodeExecution[]

  @@index([userId])
  @@index([workspaceId])
  @@index([language])
  @@index([createdAt])
}

model ProjectFile {
  id        String        @id @default(uuid())
  projectId String
  project   CodingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  path      String
  content   String        @db.Text
  language  String        @default("python")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  versions  CodeVersion[]

  @@index([projectId])
  @@index([path])
}

model CodeVersion {
  id            String         @id @default(uuid())
  projectId     String
  project       CodingProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileId        String?
  file          ProjectFile?   @relation(fields: [fileId], references: [id], onDelete: SetNull)
  versionNumber Int
  content       String         @db.Text
  description   String?
  createdAt     DateTime       @default(now())

  @@index([projectId])
  @@index([fileId])
  @@index([versionNumber])
  @@index([createdAt])
}

model CodeExecution {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?
  project     CodingProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  language    String
  code        String         @db.Text
  status      String         @default("completed") // completed, timeout, failed
  exitCode    Int            @default(0)
  stdout      String         @default("") @db.Text
  stderr      String         @default("") @db.Text
  durationMs  Int            @default(0)
  testResults Json?
  createdAt   DateTime       @default(now())

  @@index([userId])
  @@index([projectId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================
// NEXUS PICTURE STUDIO & WEBPAGE CAPTURE
// ============================================================

model WebCapture {
  id             String            @id @default(uuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId    String?
  workspace      Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  url            String
  resolvedUrl    String?
  title          String            @default("Web Capture")
  screenshotPath String            @db.Text
  width          Int               @default(1280)
  height         Int               @default(800)
  format         String            @default("png")
  fileSize       Int               @default(0)
  durationMs     Int               @default(0)
  status         String            @default("completed") // completed, failed, processing
  error          String?           @db.Text
  telemetry      Json?
  headings       Json?
  excerpt        String?           @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  analyses       CaptureAnalysis[]

  @@index([userId])
  @@index([workspaceId])
  @@index([url])
  @@index([status])
  @@index([createdAt])
}

model CaptureAnalysis {
  id         String     @id @default(uuid())
  captureId  String
  capture    WebCapture @relation(fields: [captureId], references: [id], onDelete: Cascade)
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   String     @default("ai")
  model      String     @default("qwen3:8b")
  content    String     @db.Text
  status     String     @default("completed")
  createdAt  DateTime   @default(now())

  @@index([captureId])
  @@index([userId])
  @@index([createdAt])
}

// ============================================================
// NEXUS BROWSER DOWNLOADS, BOOKMARKS & HISTORY
// ============================================================

model DownloadRecord {
  id                String     @id @default(uuid())
  userId            String
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId       String?
  workspace         Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  filename          String
  sourceUrl         String?    @db.Text
  sourceDomain      String?
  mimeType          String?
  extension         String?
  expectedSize      Int        @default(0)
  downloadedSize    Int        @default(0)
  status            String     @default("completed") // completed, in_progress, paused, failed, cancelled
  error             String?    @db.Text
  filePath          String?    @db.Text
  managedStorageRef String?
  nativeDownloadId  String?
  sha256            String?
  metadata          Json?
  createdAt         DateTime   @default(now())
  completedAt       DateTime?
  updatedAt         DateTime   @updatedAt

  @@index([userId])
  @@index([workspaceId])
  @@index([status])
  @@index([extension])
  @@index([createdAt])
}

model Bookmark {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  title       String
  url         String     @db.Text
  faviconUrl  String?    @db.Text
  folder      String?    @default("General")
  tags        String[]
  notes       String?    @db.Text
  isPinned    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId])
  @@index([workspaceId])
  @@index([folder])
  @@index([createdAt])
}

model BrowserHistoryItem {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId  String?
  workspace    Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  title        String
  url          String     @db.Text
  faviconUrl   String?    @db.Text
  visitCount   Int        @default(1)
  isAgentVisit Boolean    @default(false)
  lastVisitedAt DateTime  @default(now())
  createdAt    DateTime   @default(now())

  @@index([userId])
  @@index([workspaceId])
  @@index([url])
  @@index([lastVisitedAt])
}

// ============================================================
// NEXUS AUTOMATION STUDIO: INTEGRATION CONNECTIONS
// ============================================================

model IntegrationConnection {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String    // whatsapp, ai, sandbox, research, capture, database
  name           String
  status         String    @default("connected") // connected, degraded, unconfigured, failed
  scopes         String[]
  config         Json?
  lastVerifiedAt DateTime?
  latencyMs      Int?
  error          String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, provider])
  @@index([userId])
  @@index([provider])
  @@index([status])
}

